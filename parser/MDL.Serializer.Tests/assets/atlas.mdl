texture "Images/Atlas"
regions [
  { name slime-1 x 0 y 0 width 20 height 20 }
  { name slime-2 x 0 y 20 width 20 height 20 }
  { name bat-1 x 20 y 0 width 20 height 20 }
  { name bat-2 x 20 y 20 width 20 height 20 }
  { name bat-3 x 40 y 0 width 20 height 20 }
]
animations [
  {
    name slime-animation
    delay 200
    frames [slime-1 slime-2]
  }
  {
    name bat-animation
    delay 200
    frames [bat-1 bat-2 bat-1 bat-3]
  }
]
